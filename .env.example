# ScaleGuard Docker settings. `./scaleguard-docker.sh` copies this to .env and fills in the passwords.
# .env holds secrets: it is git-ignored, keep it that way.

# --- admin login (required) ---------------------------------------------------------------------------------------------
SCALEGUARD_ADMIN_USER=scaleguard
SCALEGUARD_ADMIN_PASSWORD=

# --- ports published on the host ----------------------------------------------------------------------------------------
SCALEGUARD_HTTP_PUBLISH=80
SCALEGUARD_HTTPS_PUBLISH=443
SCALEGUARD_SSH_PUBLISH=2222
# SCALEGUARD_DNS_PUBLISH=53

# --- configuration store -------------------------------------------------------------------------------------------------
# Empty = SQLite inside the data volume. For PostgreSQL either run `./scaleguard-docker.sh up --postgres` (starts one and fills
# these in) or point at your own:
SCALEGUARD_DB_URL=
SCALEGUARD_DB_USER=
SCALEGUARD_DB_PASSWORD=
# Used only by the bundled postgres service:
# POSTGRES_PASSWORD=

# --- data location -------------------------------------------------------------------------------------------------------
# Mounted at /data in the container: the DuckDB cache and analytics, the SQLite/ledger store, certificates and the licence.
# A volume name (default) or a host folder, e.g. SCALEGUARD_DATA_DIR=./data (bind mount; files are owned by root).
# SCALEGUARD_DATA_DIR=scaleguard-data

# --- DuckDB: response cache and request analytics (cache.duckdb and analytics.duckdb under /data) ------------------------
SCALEGUARD_CACHE_BACKEND=duckdb
SCALEGUARD_L1_CACHE_SIZE=2000
SCALEGUARD_ANALYTICS=true

# --- DNS server (./scaleguard-docker.sh up --dns sets this and publishes port 53) ----------------------------------------
SCALEGUARD_DNS=false
SCALEGUARD_DNS_PROXY=8.8.8.8,1.1.1.1

# --- tuning --------------------------------------------------------------------------------------------------------------
SCALEGUARD_RATE_LIMIT=10000
# share of the container's memory used as Java heap (the rest is for Netty buffers and DuckDB)
SCALEGUARD_HEAP_PERCENT=50
# any extra JVM flags, e.g. -Dscaleguard.http3=false -Dscaleguard.cluster.mode=postgres
SCALEGUARD_EXTRA_OPTS=
